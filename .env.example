# Kopiere diese Datei nach ".env" und passe die Werte an.
# docker-compose liest .env automatisch ein.

MYSQL_DATABASE=bass
MYSQL_USER=bass
MYSQL_PASSWORD=basspass
# Hinweis: MYSQL_ROOT_PASSWORD wird nicht mehr hier gesetzt. Nur der lokale
# Dev-DB-Container braucht ein root-Passwort und zieht dafuer den Default
# "rootpass" aus docker-compose.yml. In Prod (native MySQL) gibt es keinen
# Container -> root verwaltest du direkt auf dem Server (sudo mysql).

# --- Admin-Bereich (/admin) ---
# Ohne gesetztes Passwort ist der Admin-Login komplett gesperrt.
ADMIN_USERNAME=admin
# Empfohlen: Passwort-Hash statt Klartext. Erzeugen mit:
#   python -c "from werkzeug.security import generate_password_hash as g; print(g(input('Passwort: ')))"
ADMIN_PASSWORD_HASH=
# Alternative (weniger sicher): Klartext-Passwort. Nur nutzen, wenn kein Hash gesetzt ist.
# ADMIN_PASSWORD=

# Schluessel fuer signierte Login-Sessions. In Produktion PFLICHT (langer Zufallswert)!
# Erzeugen mit:  python -c "import secrets; print(secrets.token_hex(32))"
FLASK_SECRET_KEY=

# --- Ressourcen (v.a. fuer Prod) ---
# Anzahl der gunicorn-Worker. Weniger Worker = weniger RAM (~40-60 MB pro Worker).
# Bei sehr kleinen Instanzen (~1 GB RAM) ruhig auf 1 setzen.
WEB_WORKERS=2
# Harte RAM-Obergrenze fuer den web-Container (Docker mem_limit).
WEB_MEM_LIMIT=384m

# --- Nur Prod (docker-compose.prod.yml) ---
# In Prod laeuft MySQL NATIV auf dem Host (kein db-Container). Die MYSQL_*-Werte
# oben muessen dann zu diesem nativen MySQL-Benutzer/-Schema passen. Der Container
# nutzt Host-Netz und verbindet sich ueber 127.0.0.1:3306.
