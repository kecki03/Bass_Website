# Kopiere diese Datei nach ".env" und passe die Werte an.
# docker-compose liest .env automatisch ein.

MYSQL_DATABASE=bass
MYSQL_USER=bass
MYSQL_PASSWORD=basspass
MYSQL_ROOT_PASSWORD=rootpass

# --- Admin-Bereich (/admin) ---
# Ohne gesetztes Passwort ist der Admin-Login komplett gesperrt.
ADMIN_USERNAME=admin
# Empfohlen: Passwort-Hash statt Klartext. Erzeugen mit:
#   python -c "from werkzeug.security import generate_password_hash as g; print(g(input('Passwort: ')))"
ADMIN_PASSWORD_HASH=
# Alternative (weniger sicher): Klartext-Passwort. Nur nutzen, wenn kein Hash gesetzt ist.
# ADMIN_PASSWORD=

# Schluessel fuer signierte Login-Sessions. In Produktion PFLICHT (langer Zufallswert)!
# Erzeugen mit:  python -c "import secrets; print(secrets.token_hex(32))"
FLASK_SECRET_KEY=
